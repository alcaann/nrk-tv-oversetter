{
  "name": "nrk-tv-oversetter",
  "version": "0.2.0",
  "description": "Browser extension that translates Norwegian subtitles on NRK TV in real-time using the browser's built-in on-device Translator API",
  "repository": {
    "type": "git",
    "url": "https://github.com/alcaann/nrk-tv-oversetter.git"
  },
  "homepage": "https://github.com/alcaann/nrk-tv-oversetter#readme",
  "bugs": {
    "url": "https://github.com/alcaann/nrk-tv-oversetter/issues"
  },
  "author": "alcaann",
  "license": "MIT",
  "keywords": [
    "chrome-extension",
    "edge-extension",
    "nrk",
    "subtitles",
    "translation",
    "translator-api",
    "norwegian"
  ],
  "scripts": {
    "build": "tsc && npm run copy-assets && npm run bundle-content",
    "copy-assets": "node scripts/copy-assets.js",
    "bundle-content": "node scripts/bundle-content-script.js",
    "watch": "tsc --watch",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "typescript": "^5.3.3",
    "rimraf": "^5.0.5"
  },
  "dependencies": {}
}
